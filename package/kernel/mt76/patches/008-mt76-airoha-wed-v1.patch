From 5f8dd2d2d4dbeada1bb2da58e4d2b81e64fa2118 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroha <me@sirherobrine23.com.br>
Date: Mon, 31 Aug 2026 12:46:33 +1000
Subject: [PATCH] wifi: mt76: enable the Airoha WED v1 data path

Remove the attach-only debugging bypasses that kept Airoha devices on
the native WPDMA queues. Use the WED-owned TX, TX-free and interrupt
paths, and build the fixed 128-byte descriptor required by WED v1.

Signed-off-by: Matheus Sampaio Queiroha <me@sirherobrine23.com.br>
---
 mmio.c        | 13 ++-----
 mt7915/dma.c  | 99 ++++++++++++---------------------------------------
 mt7915/mac.c  | 11 ++++--
 mt7915/mcu.c  | 17 ++++-----
 mt7915/mmio.c | 64 ++-------------------------------
 mt7915/pci.c  | 24 ++-----------
 6 files changed, 44 insertions(+), 184 deletions(-)

diff --git a/mmio.c b/mmio.c
index eadad10..05d74cd 100644
--- a/mmio.c
+++ b/mmio.c
@@ -83,20 +83,11 @@ void mt76_set_irq_mask(struct mt76_dev *dev, u32 addr,
 	dev->mmio.irqmask &= ~clear;
 	dev->mmio.irqmask |= set;
 	if (addr) {
-		if (mtk_wed_device_active(&dev->mmio.wed)) {
+		if (mtk_wed_device_active(&dev->mmio.wed))
 			mtk_wed_device_irq_set_mask(&dev->mmio.wed,
 						    dev->mmio.irqmask);
-
-			/*
-			 * Airoha WED bring-up keeps the native PCI IRQ enabled for
-			 * MCU and other non-offloaded WPDMA events while the WED
-			 * interrupt agent is being validated.
-			 */
-			if (IS_ENABLED(CONFIG_NET_AIROHA_SOC_WED))
-				mt76_mmio_wr(dev, addr, dev->mmio.irqmask);
-		} else {
+		else
 			mt76_mmio_wr(dev, addr, dev->mmio.irqmask);
-		}
 	}
 	spin_unlock_irqrestore(&dev->mmio.irq_lock, flags);
 }
