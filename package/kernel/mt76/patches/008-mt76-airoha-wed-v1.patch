 			       MT_RX_BUF_SIZE, wa_rx_base);
 	if (ret)
 		return ret;
-	dev_info(mdev->dev,
-		 "wed dma_init: WA MCU queue allocated idx=%d base=%08x flags=%08x wed=%p\n",
-		 wa_rx_idx, wa_rx_base, mdev->q_rx[MT_RXQ_MCU_WA].flags,
-		 mdev->q_rx[MT_RXQ_MCU_WA].wed);
-
 	/* rx data queue for band0 */
 	if (!dev->phy.mt76->band_idx) {
 		if (mtk_wed_device_active(&mdev->mmio.wed) &&
diff --git a/mt7915/mac.c b/mt7915/mac.c
index cd12325..19dc4c2 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -809,10 +809,15 @@ int mt7915_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 u32 mt7915_wed_init_buf(void *ptr, dma_addr_t phys, int token_id)
 {
 	struct mt76_connac_fw_txp *txp = ptr + MT_TXD_SIZE;
+	u32 payload_offset = MT_TXD_SIZE + sizeof(*txp);
 	__le32 *txwi = ptr;
 	u32 val;
 
-	memset(ptr, 0, MT_TXD_SIZE + sizeof(*txp));
+	/* Airoha WED v1 fetches a fixed-size 128-byte host descriptor. */
+	if (IS_ENABLED(CONFIG_NET_AIROHA_SOC_WED))
+		payload_offset = 128;
+
+	memset(ptr, 0, payload_offset);
 
 	val = FIELD_PREP(MT_TXD0_TX_BYTES, MT_TXD_SIZE) |
 	      FIELD_PREP(MT_TXD0_PKT_FMT, MT_TX_TYPE_CT);
@@ -824,9 +829,9 @@ u32 mt7915_wed_init_buf(void *ptr, dma_addr_t phys, int token_id)
 
 	txp->token = cpu_to_le16(token_id);
 	txp->nbuf = 1;
-	txp->buf[0] = cpu_to_le32(phys + MT_TXD_SIZE + sizeof(*txp));
+	txp->buf[0] = cpu_to_le32(phys + payload_offset);
 
-	return MT_TXD_SIZE + sizeof(*txp);
+	return payload_offset;
 }
 
