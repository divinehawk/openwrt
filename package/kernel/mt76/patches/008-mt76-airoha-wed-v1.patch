@@ -453,15 +425,8 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 		if (!is_mt798x(mdev)) {
 			u8 wed_control_rx1 = is_mt7915(mdev) ? 1 : 2;
 
-			if (IS_ENABLED(CONFIG_NET_AIROHA_SOC_WED)) {
